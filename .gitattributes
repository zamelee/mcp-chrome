# Unix shell scripts must stay LF even on Windows checkouts (core.autocrlf),
# otherwise run_host.sh ships with CRLF and the native messaging host fails to
# start on macOS/Linux: run_host.sh: line N: $'\r': command not found
*.sh text eol=lf
*.bat text eol=crlf

# YAML / JSON / Markdown / lockfiles must stay LF for cross-platform builds
# (pnpm lockfile integrity, GitHub diff cleanliness, Linux reviewer sanity)
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.lock text eol=lf
*.tsbuildinfo text eol=lf

# LFS for binary onnx
*.onnx filter=lfs diff=lfs merge=lfs -text
